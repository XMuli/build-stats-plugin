<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="Build Stats">
    <f:entry title="Minutes to investigate each failure" field="minutesPerFailure"
             description="Failure count multiplied by these minutes. Not included in execution time.">
      <f:number clazz="positive-number" min="0" max="480" default="15"/>
    </f:entry>
  </f:section>
</j:jelly>
