<?jelly escape-by-default='true'?>
<!--
  Live resource usage of the Jenkins controller.

  The cards are empty until the first sample arrives; the script fills the values and draws the
  sparklines, and stops polling while the page is hidden. Platform support, permissions and the
  sampling-error path are unchanged — the server still refuses to sample where it cannot.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:app-bar title="${it.msg('host.title')}" subtitle="${it.msg('host.subtitle')}">
    <span class="bv-live-pill" data-bv-live-status="">${it.msg('host.offline')}</span>
    <div class="jenkins-select">
      <label class="jenkins-visually-hidden" for="bv-pace">${it.msg('host.pace')}</label>
      <select class="jenkins-select__input" id="bv-pace" data-bv-pace="">
        <option value="1">${it.msg('host.pace1')}</option>
        <option value="5" selected="selected">${it.msg('host.pace5')}</option>
      </select>
    </div>
  </l:app-bar>

  <j:choose>
    <j:when test="${!it.machineSupported}">
      <p class="bv-empty">${it.msg('host.unsupported')}</p>
    </j:when>
    <j:otherwise>
      <h2 class="bv-h2">${it.msg('host.resources')}</h2>
      <div class="bv-board bv-board--live">
        <article class="jenkins-card bv-live" data-live="cpu">
          <div class="jenkins-card__title">${it.msg('host.cpu')}</div>
          <div class="jenkins-card__content">
            <strong class="bv-live__value">--</strong>
            <p class="bv-live__sub" data-bv-cpu-meta="">${it.msg('host.usage')}</p>
            <!-- A real button: Enter and Space both work, and it reports its state. -->
            <button class="jenkins-button jenkins-button--tertiary bv-core-toggle" type="button"
                    data-bv-cpu-toggle="" aria-pressed="false">${it.msg('host.cores')}</button>
            <div class="bv-core-grid" hidden="hidden"/>
            <svg class="bv-spark" viewBox="0 0 320 120" preserveAspectRatio="none" aria-hidden="true"/>
          </div>
        </article>

        <article class="jenkins-card bv-live" data-live="mem">
          <div class="jenkins-card__title">${it.msg('host.mem')}</div>
          <div class="jenkins-card__content">
            <strong class="bv-live__value">--</strong>
            <p class="bv-live__sub">${it.msg('host.usage')}</p>
            <svg class="bv-spark" viewBox="0 0 320 120" preserveAspectRatio="none" aria-hidden="true"/>
          </div>
        </article>

        <article class="jenkins-card bv-live" data-live="disk">
          <div class="jenkins-card__title">${it.msg('host.disk')}</div>
          <div class="jenkins-card__content">
            <strong class="bv-live__value">--</strong>
            <p class="bv-live__sub">${it.msg('host.usage')}</p>
            <svg class="bv-spark" viewBox="0 0 320 120" preserveAspectRatio="none" aria-hidden="true"/>
            <!-- Per-volume usage, filled from the same sample. -->
            <div class="bv-disk-list"/>
          </div>
        </article>

        <!-- Populated only when the controller reports a GPU. -->
        <div class="bv-gpu-slot"/>
      </div>

      <h2 class="bv-h2">${it.msg('host.io')}</h2>
      <div class="bv-board bv-board--live">
        <article class="jenkins-card bv-live" data-live="down">
          <div class="jenkins-card__title">${it.msg('host.down')}</div>
          <div class="jenkins-card__content">
            <strong class="bv-live__value">--</strong>
            <p class="bv-live__sub">${it.msg('host.incoming')}</p>
            <svg class="bv-spark" viewBox="0 0 320 120" preserveAspectRatio="none" aria-hidden="true"/>
          </div>
        </article>
        <article class="jenkins-card bv-live" data-live="up">
          <div class="jenkins-card__title">${it.msg('host.up')}</div>
          <div class="jenkins-card__content">
            <strong class="bv-live__value">--</strong>
            <p class="bv-live__sub">${it.msg('host.outgoing')}</p>
            <svg class="bv-spark" viewBox="0 0 320 120" preserveAspectRatio="none" aria-hidden="true"/>
          </div>
        </article>
        <article class="jenkins-card bv-live" data-live="read">
          <div class="jenkins-card__title">${it.msg('host.read')}</div>
          <div class="jenkins-card__content">
            <strong class="bv-live__value">--</strong>
            <p class="bv-live__sub">${it.msg('host.perSecond')}</p>
            <svg class="bv-spark" viewBox="0 0 320 120" preserveAspectRatio="none" aria-hidden="true"/>
          </div>
        </article>
        <article class="jenkins-card bv-live" data-live="write">
          <div class="jenkins-card__title">${it.msg('host.write')}</div>
          <div class="jenkins-card__content">
            <strong class="bv-live__value">--</strong>
            <p class="bv-live__sub">${it.msg('host.perSecond')}</p>
            <svg class="bv-spark" viewBox="0 0 320 120" preserveAspectRatio="none" aria-hidden="true"/>
          </div>
        </article>
      </div>

      <l:card title="${it.msg('host.now')}">
        <table class="jenkins-table jenkins-table--small">
          <thead>
            <tr>
              <th>${it.msg('host.event')}</th>
              <th>${it.msg('host.details')}</th>
            </tr>
          </thead>
          <!-- Rows are filled from the activity endpoint, which applies the same read permission
               as the rest of the page. -->
          <tbody data-bv-activity="">
            <tr><th scope="row">${it.msg('host.lastBuild')}</th><td data-bv-row="lastBuild">—</td></tr>
            <tr><th scope="row">${it.msg('host.uptime')}</th><td data-bv-row="uptime">—</td></tr>
            <tr><th scope="row">${it.msg('host.users')}</th><td data-bv-row="users">—</td></tr>
            <tr><th scope="row">${it.msg('host.building')}</th><td data-bv-row="builds">—</td></tr>
            <tr><th scope="row">${it.msg('host.downloads')}</th><td data-bv-row="downloads">—</td></tr>
          </tbody>
        </table>
      </l:card>
    </j:otherwise>
  </j:choose>
</j:jelly>
