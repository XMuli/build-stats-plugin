<?jelly escape-by-default='true'?>
<!--
  The Build Stats page shell, shared by every page of the plugin.

  The overview renders this directly. computer/, about/ and job/<name>/ render it from their own
  index.jelly, and "page" and the selected job come from the URL path, so the sidebar, styles and
  script are the same everywhere and l:task can mark the current page. All text comes from the
  resource bundle for the request's locale, so the first HTML response is already in the right
  language.

  Assets come from resURL, which changes with every Jenkins start, so a plugin update is picked up
  without a version query to maintain.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <j:set var="view" value="${it.view}"/>
  <j:set var="page" value="${it.page}"/>
  <j:choose>
    <j:when test="${page == 'computer'}"><j:set var="pageTitle" value="${it.msg('host.title')}"/></j:when>
    <j:when test="${page == 'about'}"><j:set var="pageTitle" value="${it.msg('about.title')}"/></j:when>
    <j:when test="${view.jobSelected}"><j:set var="pageTitle" value="${view.selected.shortName}"/></j:when>
    <j:otherwise><j:set var="pageTitle" value="${it.displayName}"/></j:otherwise>
  </j:choose>

  <l:layout title="${pageTitle}">
    <l:header>
      <link rel="stylesheet" href="${resURL}/plugin/build-stats/css/build-stats.css" type="text/css"/>
    </l:header>

    <l:side-panel>
      <st:include page="sidebar.jelly" it="${it}"/>
    </l:side-panel>

    <l:main-panel>
      <j:choose>
        <j:when test="${page == 'computer'}">
          <st:include page="computer.jelly" it="${it}"/>
        </j:when>
        <j:when test="${page == 'about'}">
          <st:include page="about.jelly" it="${it}"/>
        </j:when>
        <j:otherwise>
          <st:include page="overview.jelly" it="${it}"/>
        </j:otherwise>
      </j:choose>

      <!-- One external script, no inline JS, so the page satisfies a strict CSP. -->
      <script src="${resURL}/plugin/build-stats/js/build-stats.js" type="text/javascript"/>
    </l:main-panel>
  </l:layout>
</j:jelly>
